{
  "name": "fedex-test-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:smoke": "npx playwright test tests/suites/smoke/singleShipmentFlow.spec.ts --headed --workers=1 --project=\"Google Chrome\"",
    "seed:bulk": "npx playwright test tests/seedBulkOrders.spec.ts --workers=1 --project=\"Google Chrome\" --reporter=line",
    "test:bulk-labels": "npx playwright test tests/label_generation/bulkAutoLabelGeneration.spec.ts --headed --project=\"Google Chrome\"",
    "codegen": "npx playwright codegen",
    "show-report": "npx playwright show-report",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Anuja B",
  "license": "ISC",
  "description": "Fedex test automation project using Playwright",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-playwright": "^1.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "playwright-smart-reporter": "^1.0.8"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "dotenv": "^17.2.4",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.2"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint --max-warnings=1",
    "tests/**/*.ts": "eslint --max-warnings=1"
  }
}
